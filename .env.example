# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cqupt_src?schema=public"

# JWT signing secret for server-side auth cookie
JWT_SECRET="replace-with-a-strong-random-secret"

# Optional Redis URL for email verification code storage
# If omitted, server falls back to in-memory storage (single instance only)
REDIS_URL="redis://127.0.0.1:6379"

# Optional SMTP settings for sending verification emails
# If omitted, server falls back to console sender and returns devCode in non-production
SMTP_HOST="smtp.your-mail-provider.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@cqupt.edu.cn"
SMTP_PASS="replace-with-smtp-password"
SMTP_FROM="CQUPT-SRC <noreply@cqupt.edu.cn>"
